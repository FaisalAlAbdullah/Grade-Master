.MODEL SMALL
.STACK 100H

.DATA

; -----------------------
; General
; -----------------------

TITLE_MSG DB 13,10,'GRADEMASTER 8086$'

SIZE_MSG DB 13,10,'Enter number of students (1-20): $'
BAD_SIZE_MSG DB 13,10,'Invalid number. Enter 1 to 20.$'

MENU_MSG DB 13,10,'1. Add Student Record'
         DB 13,10,'2. Calculate Total & Percentage'
         DB 13,10,'3. Grade Calculation'
         DB 13,10,'4. Search Student by ID'
         DB 13,10,'5. Update Student Record'
         DB 13,10,'6. Find Highest & Lowest Scorer'
         DB 13,10,'7. Exit'
         DB 13,10,'Enter Choice: $'

BAD_MENU_MSG DB 13,10,'Invalid Menu Choice.$'
NO_DATA_MSG DB 13,10,'No student record found.$'


; -----------------------
; Feature 1 data
; -----------------------

ID_MSG DB 13,10,'Enter 4-digit Student ID: $'

M1_MSG DB 13,10,'Enter Mark 1 (0-100): $'
M2_MSG DB 13,10,'Enter Mark 2 (0-100): $'
M3_MSG DB 13,10,'Enter Mark 3 (0-100): $'

SAVE_MSG DB 13,10,'Student Record Saved.$'
FULL_MSG DB 13,10,'Student limit reached.$'

BAD_ID_MSG DB 13,10,'Invalid Student ID.$'
DUP_MSG DB 13,10,'Student ID already exists.$'
BAD_MARK_MSG DB 13,10,'Invalid Mark. Enter 0 to 100.$'


; Arrays

ID1 DB 20 DUP(?)
ID2 DB 20 DUP(?)
ID3 DB 20 DUP(?)
ID4 DB 20 DUP(?)

MARK1 DB 20 DUP(?)
MARK2 DB 20 DUP(?)
MARK3 DB 20 DUP(?)

TOTALS DW 20 DUP(?)
PERCENT DB 20 DUP(?)
GRADES DB 20 DUP(?)


STUDENT_COUNT DB 0
MAX_STUDENTS DB ?


TEMP_ID1 DB ?
TEMP_ID2 DB ?
TEMP_ID3 DB ?
TEMP_ID4 DB ?

INPUT_OK DB 0

DIGIT DB ?
DIGIT_COUNT DB 0


; -----------------------
; Feature 2 data
; -----------------------

RESULT_MSG DB 13,10,'--------------------'
           DB 13,10,'Student Result$'

OUT_ID DB 13,10,'Student ID: $'
OUT_M1 DB 13,10,'Mark 1: $'
OUT_M2 DB 13,10,'Mark 2: $'
OUT_M3 DB 13,10,'Mark 3: $'
OUT_TOTAL DB 13,10,'Total: $'
OUT_PERCENT DB 13,10,'Percentage: $'
OUT_GRADE DB 13,10,'Grade: $'

PERCENT_SIGN DB '%$'

CALC_MSG DB 13,10,'Calculation completed.$'


; -----------------------
; Feature 3 data
; -----------------------

GRADE_MSG DB 13,10,'Grade calculation completed.$'


; -----------------------
; Feature 4 data
; -----------------------

SEARCH_MENU DB 13,10,'1. Exact Search'
            DB 13,10,'2. Partial Search'
            DB 13,10,'Enter Choice: $'

PARTIAL_MSG DB 13,10,'Enter partial ID (1-4 digits), then ENTER: $'

FOUND_MSG DB 13,10,'Student Found.$'
NOT_FOUND_MSG DB 13,10,'Student Not Found.$'
MATCH_MSG DB 13,10,'Matching Student:$'

BAD_SEARCH_MSG DB 13,10,'Invalid search input.$'

SEARCH_ID DB 4 DUP(?)
SEARCH_LEN DB 0

FOUND DB 0


; -----------------------
; Feature 5 data
; -----------------------

UPDATE_ID_MSG DB 13,10,'Enter Student ID to update: $'

NEW_M1_MSG DB 13,10,'Enter New Mark 1 (0-100): $'
NEW_M2_MSG DB 13,10,'Enter New Mark 2 (0-100): $'
NEW_M3_MSG DB 13,10,'Enter New Mark 3 (0-100): $'

UPDATE_DONE_MSG DB 13,10,'Student Record Updated.$'
UPDATE_FAIL_MSG DB 13,10,'Student ID not found.$'

UPDATE_INDEX DW ?


; -----------------------
; Feature 6 data
; -----------------------

HIGH_MSG DB 13,10,'--------------------'
         DB 13,10,'Highest Scorer$'

LOW_MSG DB 13,10,'--------------------'
        DB 13,10,'Lowest Scorer$'

MAX_TOTAL DW ?
MIN_TOTAL DW ?


.CODE

MAIN PROC

MOV AX,@DATA
MOV DS,AX


; Program title

MOV AH,9
LEA DX,TITLE_MSG
INT 21H


; -----------------------
; Student limit
; -----------------------

GET_SIZE:

MOV AH,9
LEA DX,SIZE_MSG
INT 21H

CALL READ_SIZE

CMP INPUT_OK,1
JE SIZE_OK

MOV AH,9
LEA DX,BAD_SIZE_MSG
INT 21H

JMP GET_SIZE


SIZE_OK:

MOV MAX_STUDENTS,AL


; =======================
; Main menu
; =======================

MAIN_MENU:

MOV AH,9
LEA DX,TITLE_MSG
INT 21H

MOV AH,9
LEA DX,MENU_MSG
INT 21H

MOV AH,1
INT 21H

CMP AL,'1'
JE FEATURE1

CMP AL,'2'
JE FEATURE2

CMP AL,'3'
JE FEATURE3

CMP AL,'4'
JE FEATURE4

CMP AL,'5'
JE FEATURE5

CMP AL,'6'
JE FEATURE6

CMP AL,'7'
JE EXIT_PROGRAM

MOV AH,9
LEA DX,BAD_MENU_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 1
; Add student
; =======================

FEATURE1:

MOV AL,STUDENT_COUNT
CMP AL,MAX_STUDENTS
JGE F1_FULL


; Read ID

F1_ID:

MOV AH,9
LEA DX,ID_MSG
INT 21H

CALL READ_ID

CMP INPUT_OK,1
JE F1_DUP_CHECK

MOV AH,9
LEA DX,BAD_ID_MSG
INT 21H

JMP F1_ID


; Duplicate check

F1_DUP_CHECK:

CALL FIND_EXACT_ID

CMP FOUND,1
JE F1_DUPLICATE


; Save ID

MOV AL,STUDENT_COUNT
MOV AH,0
MOV SI,AX

MOV AL,TEMP_ID1
MOV ID1[SI],AL

MOV AL,TEMP_ID2
MOV ID2[SI],AL

MOV AL,TEMP_ID3
MOV ID3[SI],AL

MOV AL,TEMP_ID4
MOV ID4[SI],AL


; Mark 1

F1_MARK1:

MOV AH,9
LEA DX,M1_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F1_SAVE_M1

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F1_MARK1


F1_SAVE_M1:

MOV CL,STUDENT_COUNT
MOV CH,0
MOV SI,CX

MOV MARK1[SI],AL


; Mark 2

F1_MARK2:

MOV AH,9
LEA DX,M2_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F1_SAVE_M2

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F1_MARK2


F1_SAVE_M2:

MOV CL,STUDENT_COUNT
MOV CH,0
MOV SI,CX

MOV MARK2[SI],AL


; Mark 3

F1_MARK3:

MOV AH,9
LEA DX,M3_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F1_SAVE_M3

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F1_MARK3


F1_SAVE_M3:

MOV CL,STUDENT_COUNT
MOV CH,0
MOV SI,CX

MOV MARK3[SI],AL


INC STUDENT_COUNT

MOV AH,9
LEA DX,SAVE_MSG
INT 21H

JMP MAIN_MENU


F1_DUPLICATE:

MOV AH,9
LEA DX,DUP_MSG
INT 21H

JMP F1_ID


F1_FULL:

MOV AH,9
LEA DX,FULL_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 2
; Total and percentage
; =======================

FEATURE2:

CMP STUDENT_COUNT,0
JE NO_RECORD

CALL CALCULATE_ALL


MOV SI,0

MOV CL,STUDENT_COUNT
MOV CH,0


F2_LOOP:

CALL DISPLAY_TOTAL_PERCENT

INC SI

LOOP F2_LOOP


MOV AH,9
LEA DX,CALC_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 3
; Grade calculation
; =======================

FEATURE3:

CMP STUDENT_COUNT,0
JE NO_RECORD

CALL CALCULATE_ALL
CALL CALCULATE_GRADES


MOV SI,0

MOV CL,STUDENT_COUNT
MOV CH,0


F3_LOOP:

MOV AH,9
LEA DX,OUT_ID
INT 21H

CALL PRINT_ID


MOV AH,9
LEA DX,OUT_GRADE
INT 21H

MOV DL,GRADES[SI]
MOV AH,2
INT 21H


INC SI

LOOP F3_LOOP


MOV AH,9
LEA DX,GRADE_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 4
; Search student
; =======================

FEATURE4:

CMP STUDENT_COUNT,0
JE NO_RECORD

CALL CALCULATE_ALL
CALL CALCULATE_GRADES


MOV AH,9
LEA DX,SEARCH_MENU
INT 21H

MOV AH,1
INT 21H

CMP AL,'1'
JE F4_EXACT

CMP AL,'2'
JE F4_PARTIAL

MOV AH,9
LEA DX,BAD_SEARCH_MSG
INT 21H

JMP MAIN_MENU


; Exact search

F4_EXACT:

MOV AH,9
LEA DX,ID_MSG
INT 21H

CALL READ_ID

CMP INPUT_OK,1
JNE F4_BAD

CALL FIND_EXACT_ID

CMP FOUND,1
JNE F4_NOT_FOUND


MOV AH,9
LEA DX,FOUND_MSG
INT 21H

CALL DISPLAY_FULL_RECORD

JMP MAIN_MENU


F4_BAD:

MOV AH,9
LEA DX,BAD_SEARCH_MSG
INT 21H

JMP MAIN_MENU


F4_NOT_FOUND:

MOV AH,9
LEA DX,NOT_FOUND_MSG
INT 21H

JMP MAIN_MENU


; Partial search

F4_PARTIAL:

MOV AH,9
LEA DX,PARTIAL_MSG
INT 21H

CALL READ_PARTIAL

CMP INPUT_OK,1
JNE F4_BAD


MOV FOUND,0

MOV SI,0

MOV CL,STUDENT_COUNT
MOV CH,0


F4_PARTIAL_LOOP:

CALL PARTIAL_MATCH

CMP AL,1
JNE F4_NEXT


MOV FOUND,1


MOV AH,9
LEA DX,MATCH_MSG
INT 21H

CALL DISPLAY_FULL_RECORD


F4_NEXT:

INC SI

LOOP F4_PARTIAL_LOOP


CMP FOUND,1
JE MAIN_MENU


MOV AH,9
LEA DX,NOT_FOUND_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 5
; Update student
; =======================

FEATURE5:

CMP STUDENT_COUNT,0
JE NO_RECORD


MOV AH,9
LEA DX,UPDATE_ID_MSG
INT 21H

CALL READ_ID

CMP INPUT_OK,1
JNE F5_BAD_ID


CALL FIND_EXACT_ID

CMP FOUND,1
JNE F5_NOT_FOUND


MOV UPDATE_INDEX,SI


; New mark 1

F5_MARK1:

MOV AH,9
LEA DX,NEW_M1_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F5_SAVE_M1

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F5_MARK1


F5_SAVE_M1:

MOV SI,UPDATE_INDEX

MOV MARK1[SI],AL


; New mark 2

F5_MARK2:

MOV AH,9
LEA DX,NEW_M2_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F5_SAVE_M2

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F5_MARK2


F5_SAVE_M2:

MOV SI,UPDATE_INDEX

MOV MARK2[SI],AL


; New mark 3

F5_MARK3:

MOV AH,9
LEA DX,NEW_M3_MSG
INT 21H

CALL READ_MARK

CMP INPUT_OK,1
JE F5_SAVE_M3

MOV AH,9
LEA DX,BAD_MARK_MSG
INT 21H

JMP F5_MARK3


F5_SAVE_M3:

MOV SI,UPDATE_INDEX

MOV MARK3[SI],AL


; Recalculate

CALL CALCULATE_ALL
CALL CALCULATE_GRADES


MOV AH,9
LEA DX,UPDATE_DONE_MSG
INT 21H


MOV SI,UPDATE_INDEX

CALL DISPLAY_FULL_RECORD

JMP MAIN_MENU


F5_BAD_ID:

MOV AH,9
LEA DX,BAD_ID_MSG
INT 21H

JMP MAIN_MENU


F5_NOT_FOUND:

MOV AH,9
LEA DX,UPDATE_FAIL_MSG
INT 21H

JMP MAIN_MENU



; =======================
; Feature 6
; Highest and lowest
; =======================

FEATURE6:

CMP STUDENT_COUNT,0
JE NO_RECORD

CALL CALCULATE_ALL


; First student as max/min

MOV AX,TOTALS[0]

MOV MAX_TOTAL,AX
MOV MIN_TOTAL,AX


CMP STUDENT_COUNT,1
JE F6_SHOW


MOV DI,2

MOV CL,STUDENT_COUNT
MOV CH,0

DEC CX


F6_FIND_LOOP:

MOV AX,TOTALS[DI]


CMP AX,MAX_TOTAL
JLE F6_MIN

MOV MAX_TOTAL,AX


F6_MIN:

CMP AX,MIN_TOTAL
JGE F6_NEXT

MOV MIN_TOTAL,AX


F6_NEXT:

ADD DI,2

LOOP F6_FIND_LOOP


; Show all highest

F6_SHOW:

MOV AH,9
LEA DX,HIGH_MSG
INT 21H


MOV SI,0
MOV DI,0

MOV CL,STUDENT_COUNT
MOV CH,0


F6_HIGH_LOOP:

MOV AX,TOTALS[DI]

CMP AX,MAX_TOTAL
JNE F6_HIGH_NEXT


CALL DISPLAY_ID_TOTAL


F6_HIGH_NEXT:

INC SI
ADD DI,2

LOOP F6_HIGH_LOOP


; Show all lowest

MOV AH,9
LEA DX,LOW_MSG
INT 21H


MOV SI,0
MOV DI,0

MOV CL,STUDENT_COUNT
MOV CH,0


F6_LOW_LOOP:

MOV AX,TOTALS[DI]

CMP AX,MIN_TOTAL
JNE F6_LOW_NEXT


CALL DISPLAY_ID_TOTAL


F6_LOW_NEXT:

INC SI
ADD DI,2

LOOP F6_LOW_LOOP


JMP MAIN_MENU



; -----------------------
; Common cases
; -----------------------

NO_RECORD:

MOV AH,9
LEA DX,NO_DATA_MSG
INT 21H

JMP MAIN_MENU


EXIT_PROGRAM:

MOV AX,4C00H
INT 21H


MAIN ENDP



; =======================
; Procedures
; =======================


; Read student limit

READ_SIZE PROC NEAR

MOV INPUT_OK,0

MOV BX,0
MOV DIGIT_COUNT,0


RS_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JE RS_DONE


CMP AL,'0'
JL RS_FLUSH

CMP AL,'9'
JG RS_FLUSH


SUB AL,'0'

MOV DIGIT,AL

INC DIGIT_COUNT

CMP DIGIT_COUNT,2
JG RS_FLUSH


MOV AX,BX

MOV CX,10
MUL CX

MOV BX,AX


MOV AL,DIGIT
MOV AH,0

ADD BX,AX


CMP BX,20
JG RS_FLUSH


JMP RS_LOOP


RS_DONE:

CMP DIGIT_COUNT,0
JE RS_BAD

CMP BX,0
JE RS_BAD


MOV AX,BX

MOV INPUT_OK,1

RET


RS_BAD:

RET


RS_FLUSH:

CMP AL,13
JE RS_BAD


RS_FLUSH_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JNE RS_FLUSH_LOOP

RET


READ_SIZE ENDP



; Read 4 digit ID

READ_ID PROC NEAR

MOV INPUT_OK,1


MOV AH,1
INT 21H

CMP AL,'0'
JL RID_BAD1

CMP AL,'9'
JG RID_BAD1

MOV TEMP_ID1,AL

JMP RID_2


RID_BAD1:
MOV INPUT_OK,0


RID_2:

MOV AH,1
INT 21H

CMP AL,'0'
JL RID_BAD2

CMP AL,'9'
JG RID_BAD2

MOV TEMP_ID2,AL

JMP RID_3


RID_BAD2:
MOV INPUT_OK,0


RID_3:

MOV AH,1
INT 21H

CMP AL,'0'
JL RID_BAD3

CMP AL,'9'
JG RID_BAD3

MOV TEMP_ID3,AL

JMP RID_4


RID_BAD3:
MOV INPUT_OK,0


RID_4:

MOV AH,1
INT 21H

CMP AL,'0'
JL RID_BAD4

CMP AL,'9'
JG RID_BAD4

MOV TEMP_ID4,AL

RET


RID_BAD4:

MOV INPUT_OK,0

RET


READ_ID ENDP



; Read mark

READ_MARK PROC NEAR

MOV INPUT_OK,0

MOV BX,0
MOV DIGIT_COUNT,0


RM_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JE RM_DONE


CMP AL,'0'
JL RM_FLUSH

CMP AL,'9'
JG RM_FLUSH


SUB AL,'0'

MOV DIGIT,AL

INC DIGIT_COUNT

CMP DIGIT_COUNT,3
JG RM_FLUSH


MOV AX,BX

MOV CX,10
MUL CX

MOV BX,AX


MOV AL,DIGIT
MOV AH,0

ADD BX,AX


CMP BX,100
JG RM_FLUSH


JMP RM_LOOP


RM_DONE:

CMP DIGIT_COUNT,0
JE RM_BAD


MOV AX,BX

MOV INPUT_OK,1

RET


RM_BAD:

RET


RM_FLUSH:

CMP AL,13
JE RM_BAD


RM_FLUSH_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JNE RM_FLUSH_LOOP

RET


READ_MARK ENDP



; Find exact ID

FIND_EXACT_ID PROC NEAR

MOV FOUND,0

CMP STUDENT_COUNT,0
JE FE_END


MOV SI,0

MOV CL,STUDENT_COUNT
MOV CH,0


FE_LOOP:

MOV AL,ID1[SI]
CMP AL,TEMP_ID1
JNE FE_NEXT


MOV AL,ID2[SI]
CMP AL,TEMP_ID2
JNE FE_NEXT


MOV AL,ID3[SI]
CMP AL,TEMP_ID3
JNE FE_NEXT


MOV AL,ID4[SI]
CMP AL,TEMP_ID4
JNE FE_NEXT


MOV FOUND,1

RET


FE_NEXT:

INC SI

LOOP FE_LOOP


FE_END:

RET


FIND_EXACT_ID ENDP



; Calculate total and percent

CALCULATE_ALL PROC NEAR

MOV SI,0
MOV DI,0

MOV CL,STUDENT_COUNT
MOV CH,0


CA_LOOP:

MOV AL,MARK1[SI]
MOV AH,0

MOV DX,AX


MOV AL,MARK2[SI]
MOV AH,0

ADD DX,AX


MOV AL,MARK3[SI]
MOV AH,0

ADD DX,AX


MOV TOTALS[DI],DX


MOV AX,DX

MOV BL,3
DIV BL


MOV PERCENT[SI],AL


INC SI
ADD DI,2

LOOP CA_LOOP

RET


CALCULATE_ALL ENDP



; Calculate one grade

CALCULATE_GRADE PROC NEAR

CMP AL,80
JGE CG_A

CMP AL,60
JGE CG_B

CMP AL,40
JGE CG_C


MOV AL,'F'
RET


CG_A:

MOV AL,'A'
RET


CG_B:

MOV AL,'B'
RET


CG_C:

MOV AL,'C'
RET


CALCULATE_GRADE ENDP



; Calculate all grades

CALCULATE_GRADES PROC NEAR

MOV SI,0

MOV CL,STUDENT_COUNT
MOV CH,0


CG_LOOP:

MOV AL,PERCENT[SI]

CALL CALCULATE_GRADE

MOV GRADES[SI],AL


INC SI

LOOP CG_LOOP

RET


CALCULATE_GRADES ENDP



; Print student ID

PRINT_ID PROC NEAR

MOV AH,2


MOV DL,ID1[SI]
INT 21H

MOV DL,ID2[SI]
INT 21H

MOV DL,ID3[SI]
INT 21H

MOV DL,ID4[SI]
INT 21H


RET


PRINT_ID ENDP



; Print number 0-999

PRINT_NUMBER PROC NEAR

; 0-9

CMP AX,10
JGE PN_2_OR_3


MOV DL,AL
ADD DL,'0'

MOV AH,2
INT 21H

RET


PN_2_OR_3:

CMP AX,100
JGE PN_3


; 10-99

MOV BL,10

DIV BL


MOV BH,AH


MOV DL,AL
ADD DL,'0'

MOV AH,2
INT 21H


MOV DL,BH
ADD DL,'0'

MOV AH,2
INT 21H


RET


PN_3:

; 100-999

MOV BL,100

DIV BL


MOV BH,AH


MOV DL,AL
ADD DL,'0'

MOV AH,2
INT 21H


MOV AL,BH
MOV AH,0


MOV BL,10

DIV BL


MOV BH,AH


MOV DL,AL
ADD DL,'0'

MOV AH,2
INT 21H


MOV DL,BH
ADD DL,'0'

MOV AH,2
INT 21H


RET


PRINT_NUMBER ENDP



; Show total and percent

DISPLAY_TOTAL_PERCENT PROC NEAR

MOV DI,SI
ADD DI,DI


MOV AH,9
LEA DX,RESULT_MSG
INT 21H


MOV AH,9
LEA DX,OUT_ID
INT 21H

CALL PRINT_ID


MOV AH,9
LEA DX,OUT_TOTAL
INT 21H

MOV AX,TOTALS[DI]

CALL PRINT_NUMBER


MOV AH,9
LEA DX,OUT_PERCENT
INT 21H

MOV AL,PERCENT[SI]
MOV AH,0

CALL PRINT_NUMBER


MOV AH,9
LEA DX,PERCENT_SIGN
INT 21H


RET


DISPLAY_TOTAL_PERCENT ENDP



; Show full record

DISPLAY_FULL_RECORD PROC NEAR

MOV DI,SI
ADD DI,DI


MOV AH,9
LEA DX,RESULT_MSG
INT 21H


MOV AH,9
LEA DX,OUT_ID
INT 21H

CALL PRINT_ID


MOV AH,9
LEA DX,OUT_M1
INT 21H

MOV AL,MARK1[SI]
MOV AH,0

CALL PRINT_NUMBER


MOV AH,9
LEA DX,OUT_M2
INT 21H

MOV AL,MARK2[SI]
MOV AH,0

CALL PRINT_NUMBER


MOV AH,9
LEA DX,OUT_M3
INT 21H

MOV AL,MARK3[SI]
MOV AH,0

CALL PRINT_NUMBER


MOV AH,9
LEA DX,OUT_TOTAL
INT 21H

MOV AX,TOTALS[DI]

CALL PRINT_NUMBER


MOV AH,9
LEA DX,OUT_PERCENT
INT 21H

MOV AL,PERCENT[SI]
MOV AH,0

CALL PRINT_NUMBER


MOV AH,9
LEA DX,PERCENT_SIGN
INT 21H


MOV AH,9
LEA DX,OUT_GRADE
INT 21H

MOV DL,GRADES[SI]

MOV AH,2
INT 21H


RET


DISPLAY_FULL_RECORD ENDP



; Read partial ID

READ_PARTIAL PROC NEAR

MOV INPUT_OK,0

MOV SEARCH_LEN,0
MOV SI,0


RP_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JE RP_DONE


CMP AL,'0'
JL RP_FLUSH

CMP AL,'9'
JG RP_FLUSH


CMP SEARCH_LEN,4
JGE RP_FLUSH


MOV SEARCH_ID[SI],AL

INC SI
INC SEARCH_LEN


JMP RP_LOOP


RP_DONE:

CMP SEARCH_LEN,0
JE RP_BAD


MOV INPUT_OK,1

RET


RP_BAD:

RET


RP_FLUSH:

CMP AL,13
JE RP_BAD


RP_FLUSH_LOOP:

MOV AH,1
INT 21H

CMP AL,13
JNE RP_FLUSH_LOOP

RET


READ_PARTIAL ENDP



; Check partial match

PARTIAL_MATCH PROC NEAR

MOV AL,SEARCH_LEN


CMP AL,1
JE PM_1

CMP AL,2
JE PM_2

CMP AL,3
JE PM_3

CMP AL,4
JE PM_4


MOV AL,0
RET


; One digit

PM_1:

MOV AL,ID1[SI]
CMP AL,SEARCH_ID[0]
JE PM_YES

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[0]
JE PM_YES

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[0]
JE PM_YES

MOV AL,ID4[SI]
CMP AL,SEARCH_ID[0]
JE PM_YES

JMP PM_NO


; Two digits

PM_2:

MOV AL,ID1[SI]
CMP AL,SEARCH_ID[0]
JNE PM_2B

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[1]
JE PM_YES


PM_2B:

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[0]
JNE PM_2C

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[1]
JE PM_YES


PM_2C:

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[0]
JNE PM_NO

MOV AL,ID4[SI]
CMP AL,SEARCH_ID[1]
JE PM_YES

JMP PM_NO


; Three digits

PM_3:

MOV AL,ID1[SI]
CMP AL,SEARCH_ID[0]
JNE PM_3B

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[1]
JNE PM_3B

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[2]
JE PM_YES


PM_3B:

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[0]
JNE PM_NO

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[1]
JNE PM_NO

MOV AL,ID4[SI]
CMP AL,SEARCH_ID[2]
JE PM_YES

JMP PM_NO


; Four digits

PM_4:

MOV AL,ID1[SI]
CMP AL,SEARCH_ID[0]
JNE PM_NO

MOV AL,ID2[SI]
CMP AL,SEARCH_ID[1]
JNE PM_NO

MOV AL,ID3[SI]
CMP AL,SEARCH_ID[2]
JNE PM_NO

MOV AL,ID4[SI]
CMP AL,SEARCH_ID[3]
JNE PM_NO


PM_YES:

MOV AL,1
RET


PM_NO:

MOV AL,0
RET


PARTIAL_MATCH ENDP



; Show ID and total

DISPLAY_ID_TOTAL PROC NEAR

MOV AH,9
LEA DX,OUT_ID
INT 21H

CALL PRINT_ID


MOV AH,9
LEA DX,OUT_TOTAL
INT 21H

MOV AX,TOTALS[DI]

CALL PRINT_NUMBER


RET


DISPLAY_ID_TOTAL ENDP



END MAIN
